HOST=0.0.0.0
PORT=1337
APP_KEYS="toBeModified1,toBeModified2"
API_TOKEN_SALT=tobemodified
ADMIN_JWT_SECRET=tobemodified
TRANSFER_TOKEN_SALT=tobemodified
JWT_SECRET=tobemodified
HOST_MAIL = tobemodified
USER_MAIL = tobemodified
PASS_MAIL = tobemodified
JWT_SECRET_CUSTOM_AUTH = tobemodified
JWT_EXPIRES_CUSTOM_AUTH_IN= tobemodified

# Choose otp (default) or shibboleth. Restart Strapi after changing this.
AUTH_MODE=otp
# Required in shibboleth mode. Use a long random value shared only with Apache.
SHIBBOLETH_PROXY_SECRET=
# Fixed frontend URL to receive the JWT in a URL fragment.
SHIBBOLETH_RETURN_URL=https://your-domain.example/research-hub/participate
# Optional when the SP is on another host; public protected login URL on that host.
SHIBBOLETH_LOGIN_URL=
# Exact IdP entityID -> institutional email domains. Required in shibboleth mode.
SHIBBOLETH_IDP_EMAIL_DOMAINS={"https://auth.unisa.it/idp/shibboleth":["unisa.it"]}
